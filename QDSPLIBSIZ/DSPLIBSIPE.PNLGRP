004100000000:PNLGRP.
004200000000.*
004300000000:HELP name='DSPLIBSIZ/ALL'.
004400000000:IMHELP name=DSPLIBSIZ.
004500000000:IMHELP name='DSPLIBSIZ/LIB       '.
