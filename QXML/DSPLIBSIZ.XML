000000000000Compile members with the following PDM option:
000000000000
000000000000   STRPREPRC USESRCFILE(&L/&F) USESRCMBR(&N) OPTION(*EVENTF) CHGOBJD(*NO)
000000000000     LIB(&O) OBJ(&N) SRCLIB(&L) SRCFILE(&F) SRCMBR(&N) USER0(&X)
000000000000     USER1(*LIST) USER2(*FULL)
000000000000
000000000000Members of type MAKPGM or BND are used for linking programs (MAKPGM)
000000000000and service programs (BND).
000000000000
0000000000002019, Thomas Raddatz
000000000000]]>  </copysrc>
