000000000000     C                   Endsl
000000000000     C                   Endif
000000000000      *
000000000000     C                   Return    isRelease
000000000000      *
000000000000     P                 E
000000000000      *---------------------------------------------------------------------------------------------
000000000000      *  Replaces the value of a given keyword.
000000000000      *---------------------------------------------------------------------------------------------
000000000000     P setTargetRelease...
000000000000     P                 B
000000000000     D                 PI          2000A          varying
000000000000     D  i_keyword                    10A   value  varying
000000000000     D  i_string                   2000A   value  varying
000000000000     D  i_value                      10A   value  varying
000000000000      *
000000000000      *  return value
000000000000     D string          S           2000A   varying inz
000000000000      *
000000000000      *  helper fields
000000000000     D x               S             10I 0 inz
000000000000     D l               S             10I 0 inz
000000000000     D tmpKeyword      S                   like(i_keyword) inz
000000000000     D tmpString       S                   like(i_string ) inz
000000000000     D tmpCmd          S             10A   inz
000000000000      *-------------------------------------------------------------------*
000000000000      /FREE
000000000000
000000000000         tmpKeyword = uCase(%trimR(i_keyword));
000000000000         tmpString  = uCase(%trimR(i_string ));
000000000000         x = %scan(' ': tmpString);
000000000000         if x = 0;
000000000000            return i_string;
000000000000         endif;
000000000000         tmpCmd = %subst(tmpString: 1: x);
000000000000         if tmpCmd <> 'CRTRPGMOD' and
000000000000            tmpCmd <> 'CRTRPGPGM' and
000000000000            tmpCmd <> 'CRTCLMOD'  and
000000000000            tmpCmd <> 'CRTCLPGM'  and
000000000000            tmpCmd <> 'CRTCBLMOD' and
000000000000            tmpCmd <> 'CRTCBLPGM' and
000000000000            tmpCmd <> 'CRTCMOD'   and
000000000000            tmpCmd <> 'CRTCPPMOD' and
000000000000            tmpCmd <> 'CRTBNDC'   and
000000000000            tmpCmd <> 'CRTBNDCBL' and
000000000000            tmpCmd <> 'CRTBNDCL'  and
000000000000            tmpCmd <> 'CRTBNDCPP' and
000000000000            tmpCmd <> 'CRTBNDDIR' and
000000000000            tmpCmd <> 'CRTBNDRPG' and
000000000000            tmpCmd <> 'CRTPGM'    and
000000000000            tmpCmd <> 'CRTSRVPGM' ;
000000000000            return i_string;
000000000000         endif;
000000000000         x = %scan(tmpKeyword + '(': tmpString);
000000000000         if x = 0;
000000000000            return %trimR(i_string) +
000000000000                   ' ' + tmpKeyword + '(' + %trimR(i_value) + ')';
000000000000         endif;
000000000000         l = %scan(')': tmpString: x + %len(i_keyword) + 1);
000000000000         if l = 0;
000000000000            return i_string;
000000000000         endif;
000000000000         l = l - x + 1;
000000000000         string = %replace(tmpKeyword + '(' + %trimR(i_value) + ')'
000000000000                           : i_string: x: l);
000000000000         Return string;
000000000000
000000000000      /END-FREE
000000000000     P                 E
000000000000      *---------------------------------------------------------------------------------------------
000000000000      *  Store field value.
000000000000      *---------------------------------------------------------------------------------------------
000000000000     P setVariable...
000000000000     P                 B
000000000000     D                 PI
000000000000     D  i_fldName                    10A   value  varying
000000000000     D  i_value                      64A   value  varying
000000000000     D i               s             10I 0 inz
000000000000      *-------------------------------------------------------------------*
000000000000      /FREE
000000000000
000000000000         if (i_fldName = '');
000000000000            return;
000000000000         endif;
000000000000
000000000000         for i = 1 to fld_x;
000000000000            if (uCase('&' + %trim(i_fldName)) = uCase(fld_name(i)));
000000000000               fld_value(i) = i_value;
000000000000               return;
000000000000            endif;
000000000000         endfor;
000000000000
000000000000         if (fld_x >= %elem(fld_name));
000000000000            return;
000000000000         endif;
000000000000
000000000000         fld_x = fld_x + 1;
000000000000         fld_name(fld_x)  = uCase('&' + %trim(i_fldName));
000000000000         fld_value(fld_x) = i_value;
000000000000
000000000000      /END-FREE
000000000000     P                 E
000000000000      *---------------------------------------------------------------------------------------------
000000000000      *  get variable name from statement.
000000000000      *---------------------------------------------------------------------------------------------
000000000000     P getVarName...
000000000000     P                 B
000000000000     D                 PI            11a          varying
000000000000     D  i_bldexc                           value  like(bldexc)
000000000000     D  i_pos                        10i 0 value
000000000000     D name            s             11a   varying inz
000000000000     D CHARS           c                   '&ABCDEFGHIJKLMNOPQRSTUVWXYZ+
000000000000     D                                      abcdefghijklmnopqrstuvwxyz+
000000000000     D                                      1234567890_'
000000000000      *-------------------------------------------------------------------*
000000000000      /FREE
000000000000
000000000000         dow (i_pos<=%len(i_bldexc) and
000000000000              %check(CHARS:%subst(i_bldexc:i_pos:1))=0);
000000000000            name = name+%subst(i_bldexc:i_pos:1);
000000000000            i_pos=i_pos+1;
000000000000         enddo;
000000000000
000000000000         return name;
000000000000
000000000000      /END-FREE
000000000000      *
000000000000     P                 E
000000000000      *---------------------------------------------------------------------------------------------
000000000000      *  get variable value.
000000000000      *---------------------------------------------------------------------------------------------
000000000000     P getVarValue...
000000000000     P                 B
000000000000     D                 PI            64a          varying
000000000000     D  i_name                       11a   value  varying
000000000000     D i               s             10i 0 inz
000000000000     D value           s             64a   varying inz('?')
000000000000      *-------------------------------------------------------------------*
000000000000      /FREE
000000000000
000000000000         for i=1 to fld_x;
000000000000            if (ucase(fld_name(i))=uCase(i_name));
000000000000               value=%trimR(fld_value(i));
000000000000               leave;
000000000000            endif;
000000000000         endfor;
000000000000
000000000000         return value;
000000000000
000000000000      /END-FREE
000000000000      *
000000000000     P                 E
000000000000      *---------------------------------------------------------------------------------------------
000000000000      *  convert to upper case
000000000000      *---------------------------------------------------------------------------------------------
000000000000     P uCase...
000000000000     P                 B
000000000000     D                 PI          2000A          varying
000000000000     D  i_string                   2000A   value  varying
000000000000     D uCase           s           2000A   inz varying
000000000000     D LC              C                   const('abcdefghijklmnopqrstuvwxyz')
000000000000     D UC              C                   CONST('ABCDEFGHIJKLMNOPQRSTUVWXYZ')
000000000000      *-------------------------------------------------------------------*
000000000000      /FREE
000000000000
000000000000         uCase = %xlate(LC:UC:i_string);
000000000000
000000000000         return uCase;
000000000000
000000000000      /END-FREE
000000000000     P                 E
